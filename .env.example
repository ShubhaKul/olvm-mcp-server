# Copy the values into your MCP client's config (or your shell). Never commit real values.

# Engine base URL (the /api suffix is optional)
OLVM_URL=https://engine.example.com/ovirt-engine

# Keycloak installs: <user>@ovirt@internalsso   Older installs: <user>@internal
OLVM_USERNAME=mcp-reader@ovirt@internalsso

# Prefer a password file over putting the password in a config file
OLVM_PASSWORD_FILE=C:\path\to\mcp-reader.pw
# OLVM_PASSWORD=

# The engine's CA certificate:
# https://<engine>/ovirt-engine/services/pki-resource?resource=ca-certificate&format=X509-PEM-CA
OLVM_CA_FILE=C:\path\to\olvm-ca.pem

# Seconds per request (default 30)
# OLVM_TIMEOUT=30

# Lab only: skip TLS verification
# OLVM_INSECURE=false

# Write actions (start_vm, shutdown_vm, create_snapshot, migrate_vm, set_host_maintenance). Off unless set to operator.
# OLVM_MODE=read_only
# Required in operator mode: clusters that write tools may touch, or * for all
# OLVM_ALLOWED_CLUSTERS=Default
# Audit log of every write request and outcome (default ~/.olvm-mcp/audit.jsonl)
# OLVM_AUDIT_LOG=C:\path\to\olvm-mcp-audit.jsonl
