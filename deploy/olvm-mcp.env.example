# Copy to /etc/olvm-mcp/olvm-mcp.env on the server. Paths are inside the container,
# where /etc/olvm-mcp on the host is mounted read-only at the same path.
# docker compose reads this file as the user running it, so it holds no secrets:
# passwords and tokens go in their own files (engine.pw, tokens).

# Engine
OLVM_URL=https://engine.example.com/ovirt-engine
OLVM_USERNAME=mcp-operator@internalsso
OLVM_PASSWORD_FILE=/etc/olvm-mcp/engine.pw
OLVM_CA_FILE=/etc/olvm-mcp/engine-ca.pem

# What the server may do on the engine. Leave destructive actions off for remote use.
OLVM_MODE=operator
OLVM_ALLOWED_CLUSTERS=Default
# OLVM_ALLOW_DESTRUCTIVE=false

# Remote access (the image already sets OLVM_TRANSPORT=http and listens on 0.0.0.0:8000)
OLVM_AUTH_TOKENS_FILE=/etc/olvm-mcp/tokens
# The address clients use, without /mcp. Must match PUBLIC_HOST in deploy/.env.
OLVM_PUBLIC_URL=https://203.0.113.10
